# ====================================================================
# API server environment configuration
# ====================================================================

# Supabase PostgreSQL URI (Project Settings -> Database -> Connection string -> URI).
# Set this to send API data to Supabase. Do not use the https:// project URL.
# DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# Local PostgreSQL fallback (used only when DATABASE_URL is unset).
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=inventory_sales_tracker

# JWT secret and server configuration
JWT_SECRET=replace-with-a-long-random-secret
PORT=5000
NODE_ENV=development
JWT_EXPIRES_IN=24h
