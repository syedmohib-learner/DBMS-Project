# ====================================================================
# Inventory and Sales Tracker environment variables
# ====================================================================
# The API server reads DATABASE_URL. For local development, put this in
# server/.env. Get the PostgreSQL URI from Supabase Project Settings ->
# Database -> Connection string -> URI (not the Supabase HTTPS project URL).
# DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# Use a long, random secret for JWT signing.
JWT_SECRET=replace-with-a-long-random-secret

# Optional settings
# PORT=5000
# NODE_ENV=development
# JWT_EXPIRES_IN=24h
# DB_POOL_MAX=5
